--- /dev/null
+++ b/app/src/main/java/com/prism/music/ui/player/ArtThemes.kt
@@ -0,0 +1,56 @@
+package com.prism.music.ui.player
+
+import androidx.compose.foundation.border
+import androidx.compose.foundation.shape.CircleShape
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.shadow
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.unit.dp
+import com.prism.music.data.prefs.CoverShape
+import com.prism.music.data.prefs.PlayerLayout
+
+/**
+ * Player themes that dress the cover (Settings, Player, Layout). They keep the standard player
+ * and only change the cover's shape and frame, so nothing else in the player moves.
+ */
+internal object ArtThemes {
+    /** The cover's own shape for [layout], or null to keep the shape picked in Settings. */
+    fun shape(layout: PlayerLayout): CoverShape? = when (layout) {
+        PlayerLayout.ARCH -> CoverShape.ARCH
+        PlayerLayout.FLOWER -> CoverShape.FLOWER
+        PlayerLayout.SQUIRCLE -> CoverShape.SQUIRCLE
+        PlayerLayout.HALO -> CoverShape.CIRCLE
+        else -> null
+    }
+
+    /** Applied first: moves or lights the whole cover. */
+    fun Modifier.outer(layout: PlayerLayout, glow: Color): Modifier = when (layout) {
+        PlayerLayout.TILT -> graphicsLayer { rotationY = 14f; cameraDistance = 16f * density }
+        PlayerLayout.POLAROID -> graphicsLayer { rotationZ = -3f }
+        PlayerLayout.NEON -> shadow(22.dp, RoundedCornerShape(24.dp), ambientColor = glow, spotColor = glow)
+        PlayerLayout.HALO -> shadow(28.dp, CircleShape, ambientColor = glow, spotColor = glow)
+        else -> this
+    }
+
+    /** Applied after the cover is clipped to its shape: a frame drawn over its edge. */
+    fun Modifier.frame(layout: PlayerLayout, shape: Shape, a: Color, b: Color): Modifier = when (layout) {
+        PlayerLayout.NEON -> border(3.dp, Brush.linearGradient(listOf(a, b)), shape)
+        PlayerLayout.GLASS -> border(2.dp, Color.White.copy(alpha = 0.4f), shape)
+        PlayerLayout.STAMP -> border(4.dp, Color.White, shape)
+        PlayerLayout.POLAROID -> border(10.dp, Color.White, shape)
+        PlayerLayout.HALO -> border(2.dp, Color.White.copy(alpha = 0.3f), shape)
+        else -> this
+    }
+
+    /** POSTER and STAMP choose the corner size; the rest keep the Corners setting. */
+    fun corners(layout: PlayerLayout, fallback: androidx.compose.ui.unit.Dp) = when (layout) {
+        PlayerLayout.POSTER -> 36.dp
+        PlayerLayout.STAMP -> 2.dp
+        PlayerLayout.POLAROID -> 4.dp
+        else -> fallback
+    }
+}
