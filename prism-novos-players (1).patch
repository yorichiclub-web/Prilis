+/** The cover as each player dresses it: its shape and frame, in a sample's size. */
+@Composable
+private fun SampleCover(layout: PlayerLayout, fraction: Float) {
+    val grad = Brush.linearGradient(listOf(Color(0xFF8A6BFF), Color(0xFFFF7A59)))
+    val glow = Color(0xFF8A6BFF)
+    if (layout == PlayerLayout.FLOWER || layout == PlayerLayout.EXPRESSIVO) {
+        // Four overlapping petals.
+        Column(Modifier.fillMaxWidth(fraction).aspectRatio(1f)) {
+            repeat(2) {
+                Row(Modifier.weight(1f).fillMaxWidth()) {
+                    repeat(2) { Box(Modifier.weight(1f).fillMaxHeight().clip(CircleShape).background(grad)) }
+                }
+            }
+        }
+        return
+    }
+    val shape: androidx.compose.ui.graphics.Shape = when (layout) {
+        PlayerLayout.ARCH -> RoundedCornerShape(topStart = 40.dp, topEnd = 40.dp, bottomStart = 4.dp, bottomEnd = 4.dp)
+        PlayerLayout.HALO -> CircleShape
+        PlayerLayout.SQUIRCLE -> RoundedCornerShape(14.dp)
+        PlayerLayout.POSTER -> RoundedCornerShape(10.dp)
+        PlayerLayout.NEON, PlayerLayout.GLASS, PlayerLayout.TILT -> RoundedCornerShape(7.dp)
+        PlayerLayout.STAMP, PlayerLayout.POLAROID -> RoundedCornerShape(1.dp)
+        else -> RoundedCornerShape(4.dp)
+    }
+    var m: Modifier = Modifier.fillMaxWidth(fraction).aspectRatio(if (layout == PlayerLayout.POSTER) 0.8f else 1f)
+    m = when (layout) {
+        PlayerLayout.NEON, PlayerLayout.HALO -> m.shadow(7.dp, shape, ambientColor = glow, spotColor = glow)
+        PlayerLayout.POLAROID -> m.rotate(-4f)
+        PlayerLayout.TILT -> m.graphicsLayer { rotationY = 18f }
+        else -> m
+    }
+    m = m.clip(shape).background(grad)
+    m = when (layout) {
+        PlayerLayout.NEON -> m.border(1.5.dp, Brush.linearGradient(listOf(Color(0xFF8A6BFF), Color(0xFF2DE2C0))), shape)
+        PlayerLayout.GLASS -> m.border(1.dp, Color.White.copy(alpha = 0.4f), shape)
+        PlayerLayout.STAMP -> m.border(2.dp, Color.White, shape)
+        PlayerLayout.POLAROID -> m.border(4.dp, Color.White, shape)
+        else -> m
+    }
+    Box(m)
+}
