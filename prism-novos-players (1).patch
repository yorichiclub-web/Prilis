+/** A skip key on glass with a thin light edge, dimmed when it can't be used. */
+@Composable
+private fun ExpressiveKey(icon: ImageVector, description: String, enabled: Boolean, shape: androidx.compose.ui.graphics.Shape, modifier: Modifier, onClick: () -> Unit) {
+    val haptics = rememberHaptics()
+    val alpha by animateFloatAsState(if (enabled) 1f else 0.35f, label = "expressiveKey")
+    Box(
+        modifier.clip(shape).background(Color.White.copy(alpha = 0.12f)).border(1.dp, Color.White.copy(alpha = 0.22f), shape)
+            .clickable(enabled = enabled) { haptics.click(); onClick() },
+        contentAlignment = Alignment.Center,
+    ) { Icon(icon, description, tint = Color.White.copy(alpha = alpha), modifier = Modifier.size(28.dp)) }
+}
