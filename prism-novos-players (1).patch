+/**
+ * The Expressive and Big Play players' controls: round and pill keys on glass, in Prism's own light. Expressive is a wide
+ * Play pill between two round skips; Big Play is a large round Play beside two tall skip keys.
+ */
+@Composable
+private fun ExpressiveTransport(big: Boolean, isPlaying: Boolean, isLoading: Boolean, previousEnabled: Boolean, nextEnabled: Boolean) {
+    val pc = LocalContainer.current.player
+    val haptics = rememberHaptics()
+    val playLabel = if (isPlaying) tr(R.string.widget_pause) else tr(R.string.widget_play)
+    if (big) {
+        Row(Modifier.fillMaxWidth().height(150.dp), horizontalArrangement = Arrangement.spacedBy(10.dp), verticalAlignment = Alignment.CenterVertically) {
+            Box(
+                Modifier.fillMaxHeight().aspectRatio(1f).clip(CircleShape).background(Color.White).clickable { haptics.click(); pc.togglePlay() },
+                contentAlignment = Alignment.Center,
+            ) {
+                if (isLoading) CircularProgressIndicator(color = Color.Black, strokeWidth = 2.dp, modifier = Modifier.size(40.dp))
+                else Icon(if (isPlaying) PrismIcons.Pause else PrismIcons.Play, playLabel, tint = Color.Black, modifier = Modifier.size(64.dp))
+            }
+            ExpressiveKey(PrismIcons.Previous, tr(R.string.widget_previous), previousEnabled, CircleShape, Modifier.weight(1f).fillMaxHeight()) { pc.previous() }
+            ExpressiveKey(PrismIcons.Next, tr(R.string.widget_next), nextEnabled, CircleShape, Modifier.weight(1f).fillMaxHeight()) { pc.next() }
+        }
+    } else {
+        Row(Modifier.fillMaxWidth().height(76.dp), horizontalArrangement = Arrangement.spacedBy(10.dp), verticalAlignment = Alignment.CenterVertically) {
+            ExpressiveKey(PrismIcons.Previous, tr(R.string.widget_previous), previousEnabled, CircleShape, Modifier.size(76.dp)) { pc.previous() }
+            Box(
+                Modifier.weight(1f).fillMaxHeight().clip(CircleShape).background(Color.White).clickable { haptics.click(); pc.togglePlay() },
+                contentAlignment = Alignment.Center,
+            ) {
+                if (isLoading) CircularProgressIndicator(color = Color.Black, strokeWidth = 2.dp, modifier = Modifier.size(28.dp))
+                else Text(playLabel.uppercase(), color = Color.Black, fontWeight = FontWeight.Bold, fontSize = 20.sp, letterSpacing = 3.sp)
+            }
+            ExpressiveKey(PrismIcons.Next, tr(R.string.widget_next), nextEnabled, CircleShape, Modifier.size(76.dp)) { pc.next() }
+        }
+    }
